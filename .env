# Defaults para TODOS los ambientes (se commitea, sin secretos acá).
# .env.local (gitignoreado) pisa esto en desarrollo local.

# Fuente extra para el CSP connect-src de index.html (Fase 0, workflow
# local) — vacío por default para que el placeholder en index.html se
# reemplace por nada en cualquier build sin .env.local (producción real
# incluida). Ver el comentario junto al <meta> CSP en index.html.
VITE_CSP_EXTRA_CONNECT_SRC=
