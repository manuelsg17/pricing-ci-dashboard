    "test:ci-competitors": "node scripts/test-ci-competitors.mjs",
    "test:monitoring": "node scripts/test-monitoring.mjs",
    "test:timeslot-label": "node scripts/test-timeslot-label.mjs",
    "test:upload-parsers": "node scripts/test-upload-parsers.mjs",
    "test:project-tasks": "node scripts/test-project-tasks.mjs",
    "test:all": "npm run test:bot-mapping && npm run test:bracket-normalize && npm run test:bracket-parity && npm run test:get-country-config && npm run test:catalogs && npm run test:weights-cascade && npm run test:simple-avg-cutoff && npm run test:indrive-recent-ref && npm run test:format && npm run test:normalize-competitor && npm run test:ingestion-corp && npm run test:distance-refs-replication && npm run test:bracket-order && npm run test:bracket-grouping && npm run test:indrive-avg && npm run test:bot-coverage && npm run test:representativity && npm run test:ci-competitors && npm run test:monitoring && npm run test:timeslot-label && npm run test:session-fronts && npm run test:competitor-bonus && npm run test:yango-gmv-bonus && npm run test:upload-parsers && npm run test:project-tasks && npm run test:error-fingerprint && npm run test:session-persistence",
    "check:rls-drift": "psql \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -f scripts/check-rls-policy-drift.sql",
    "check:normalization-drift": "psql \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -f scripts/check-normalization-drift.sql",
    "test:session-fronts": "node scripts/test-session-fronts.mjs",
    "test:competitor-bonus": "node scripts/test-competitor-bonus.mjs",
    "test:yango-gmv-bonus": "node scripts/test-yango-gmv-bonus.mjs",
    "test:error-fingerprint": "node scripts/test-error-fingerprint.mjs",
    "simulate:permissions": "docker exec -i supabase_db_pricing-ci-dashboard psql -U postgres -X < scripts/simulate-permissions.sql",
    "test:session-persistence": "node scripts/test-session-persistence.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "7.18.1",
    "recharts": "^2.10.0",
    "tailwind-merge": "^2.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
