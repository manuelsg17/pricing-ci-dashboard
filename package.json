{
  "name": "pricing-ci-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:bot-mapping": "node scripts/test-bot-mapping.mjs",
    "test:bracket-normalize": "node scripts/test-bracket-normalize.mjs",
    "test:bracket-parity": "node scripts/test-bracket-parity.mjs",
    "test:get-country-config": "node scripts/test-getcountryconfig.mjs",
    "test:catalogs": "node scripts/test-catalogs.mjs",
    "test:weights-cascade": "node scripts/test-weights-cascade.mjs",
    "test:simple-avg-cutoff": "node scripts/test-simple-avg-cutoff.mjs",
    "test:indrive-recent-ref": "node scripts/test-indrive-recent-ref.mjs",
    "test:format": "node scripts/test-format.mjs",
    "test:normalize-competitor": "node scripts/test-normalize-competitor.mjs",
    "test:ingestion-corp": "node scripts/test-ingestion-corp.mjs",
